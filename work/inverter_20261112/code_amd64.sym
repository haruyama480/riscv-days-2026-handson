v {xschem version=3.4.8RC file_version=1.3}
G {}
K {}
V {}
S {}
F {}
E {}
N 210 20 320 20 {lab=VOUT}
N -160 -180 -160 -150 {lab=VDD}
N -160 -90 -160 -60 {lab=0}
N -100 -90 -100 -55 {lab=0}
N -100 -180 -100 -150 {lab=VIN}
N -105 0 -90 0 {lab=VIN}
N 210 -110 210 -85 {lab=VDD}
N 285 90 285 105 {lab=0}
N 285 20 285 35 {lab=VOUT}
N 210 40 210 110 {lab=0}
N 210 -25 210 0 {lab=#net1}
C {inv_dut_113.sym} 60 20 0 0 {name=x1}
C {gnd.sym} 210 105 0 0 {name=l1 lab=0}
C {gnd.sym} 285 105 0 0 {name=l2 lab=0}
C {gnd.sym} -160 -60 0 0 {name=l3 lab=0}
C {gnd.sym} -100 -60 0 0 {name=l4 lab=0}
C {lab_pin.sym} -105 0 0 0 {name=p1 sig_type=std_logic lab=VIN}
C {lab_pin.sym} 210 -110 0 0 {name=p2 sig_type=std_logic lab=VDD}
C {lab_pin.sym} -100 -180 0 0 {name=p3 sig_type=std_logic lab=VIN}
C {lab_pin.sym} 315 20 2 0 {name=p7 sig_type=std_logic lab=VOUT}
C {lab_pin.sym} -160 -180 0 0 {name=p4 sig_type=std_logic lab=VDD}
C {vsource.sym} -160 -120 0 0 {name=vdd value=3.3 savecurrent=false}
C {vsource.sym} -100 -120 0 0 {name=vin value="pwl 0 0 10n 0 20n 3.3 60n 3.3 70n 0" savecurrent=false}
C {ammeter.sym} 210 -55 0 0 {name=Vd savecurrent=true spice_ignore=0}
C {capa.sym} 285 60 0 0 {name=C1
m=1
value=10f
footprint=1206
device="ceramic capacitor"}
C {devices/code_shown.sym} 255 -395 0 0 {name=spice only_toplevel=false value=".option savecurrent
.control
save all

* Tran analysis
tran 0.1n 100n
plot vout vin
plot i(vd)
wrdata inv_dut_113_tb_dc.txt v(vout)
write inv_dut_113_tb_dc.raw

* DC analysis (I/O curve)
dc vin 0 3.3 0.01
plot vout vin
plot i(vd)
wrdata inv_dut_113_tb_tr.txt v(vout)
write inv_dut_113_tb_tr.raw
.endc"}
C {devices/code.sym} -145 -340 0 0 {name=GF180_MODELS
only_toplevel=true
format="tcleval( @value )"
value="
.include $::180MCU_MODELS/design.ngspice
.lib $::180MCU_MODELS/sm141064.ngspice typical
.lib $::180MCU_MODELS/sm141064.ngspice res_typical
.lib $::180MCU_MODELS/sm141064.ngspice moscap_typical
.lib $::180MCU_MODELS/sm141064.ngspice diode_typical
* .lib $::180MCU_MODELS/sm141064.ngspice res_statistical
"
spice_ignore=false
      }
